# 首次复制到 BABEL_DATA_DIR/config.env 并填写（带空格的值要加引号）
GITHUB_USER=your-github-username
GITHUB_REPO=babel
SHOW_TITLE="巴别塔 Babel"
SHOW_AUTHOR="巴别塔 Babel"
SHOW_EMAIL=you@users.noreply.github.com

# 支持位（可选，留空则不显示）
# 普通链接：名称=URL|名称=URL，例如 GitHub Sponsors / 爱发电 / Ko-fi
SUPPORT_LINKS="Ko-fi=https://ko-fi.com/你的名字"
# Solana Pay 捐赠链接：message 参数会通过 memo program 自动上链
# 格式: solana:<收款地址>?spl-token=<USDC mint>&label=巴别塔Babel&message=from%20babel%20site
SUPPORT_SOLANA_PAY=""
# EVM 地址（仅展示，EVM 普通转账无法附言）: 标签:地址
SUPPORT_CRYPTO=""
